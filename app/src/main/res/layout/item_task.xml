<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">

    <!-- Timeline vertical line track -->
    <View
        android:id="@+id/viewTimelineTrack"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@drawable/hud_divider"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"/>

    <!-- Timeline node dot -->
    <View
        android:id="@+id/viewTimelineDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/bg_status_active"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/cardTask"
        app:layout_constraintBottom_toBottomOf="@id/cardTask"
        android:layout_marginStart="18.5dp" />

    <!-- Task Card (Glass Panel) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTask"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginEnd="4dp"
        app:cardBackgroundColor="#181E36"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="#3300F0FF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvTaskTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="08:00"
                        android:textColor="#00F0FF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tvTaskPriority"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HIGH PRIORITY"
                        android:textColor="#00F0FF"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:background="@drawable/bg_chip_hud"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTaskTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Morning Prep"
                    android:textColor="#DCE1FF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"/>

                <LinearLayout
                    android:id="@+id/layoutProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/progressTask"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:progress="65"
                        android:progressDrawable="@drawable/bg_progress_fill"/>

                    <TextView
                        android:id="@+id/tvProgressRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="42m REMAINING"
                        android:textColor="#72F6FF"
                        android:textSize="10sp"
                        android:letterSpacing="0.08"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>

            <CheckBox
                android:id="@+id/checkboxTask"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:button="@null"
                android:background="@drawable/bg_chip_hud"
                android:gravity="center"
                android:checked="false"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
