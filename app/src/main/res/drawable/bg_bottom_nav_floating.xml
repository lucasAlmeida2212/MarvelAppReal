<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Background with rounded corners on all 4 sides for floating card appearance -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <stroke
                android:width="1dp"
                android:color="@color/bg_card_border" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Subtle Top Edge Glow -->
    <item android:bottom="4dp" android:top="-2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00000000"
                android:startColor="@color/cyan_glow_10" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
