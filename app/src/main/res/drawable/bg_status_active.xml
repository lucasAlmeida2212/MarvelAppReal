<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cyan_glow_10" />
            <stroke
                android:width="1dp"
                android:color="@color/cyan_accent" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <!-- Indicator Dot -->
    <item android:left="8dp" android:top="8dp" android:bottom="8dp" android:right="140dp">
        <shape android:shape="oval">
            <solid android:color="@color/cyan_bright" />
        </shape>
    </item>
</layer-list>