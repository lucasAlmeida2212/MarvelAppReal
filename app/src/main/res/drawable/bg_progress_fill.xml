<?xml version="1.0" encoding="utf-8"?>
<scale xmlns:android="http://schemas.android.com/apk/res/android"
    android:scaleWidth="100%">
    <layer-list>
        <!-- Main Fill -->
        <item>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:endColor="@color/cyan_accent"
                    android:startColor="@color/cyan_glow_20" />
                <corners android:radius="1dp" />
            </shape>
        </item>
        <!-- Glow Head -->
        <item android:left="300dp">
             <shape android:shape="rectangle">
                <solid android:color="@color/cyan_bright" />
                <corners android:radius="1dp" />
            </shape>
        </item>
    </layer-list>
</scale>